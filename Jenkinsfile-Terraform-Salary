pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION  = "us-east-1"
        TF_IN_AUTOMATION    = "true"
        TF_PLUGIN_CACHE_DIR = "/var/lib/jenkins/.terraform.d/plugin-cache"
    }

    options {
        disableConcurrentBuilds()
    }

    timestamps()   // << ✔ FIXED POSITION

    stages {

        stage('Checkout Terraform Repo') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init & Apply - Salary') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-dev-creds']
                ]) {

                    script {
                        def modules = [
                            'vpc',
                            'security-group',
                            'subnets',
                            'asg',
                            'alb',
                            'launch-template'
                        ]

                        for (module in modules) {
                            stage("Deploy ${module}") {
                                dir("env/dev/salary/${module}") {

                                    sh '''
                                        terraform init -reconfigure
                                        terraform validate
                                        terraform plan -out=tfplan.out
                                        terraform apply -auto-approve tfplan.out
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Salary Terraform deployment successful"
        }
        failure {
            echo "❌ Salary Terraform deployment failed"
        }
        always {
            cleanWs()
        }
    }
}
