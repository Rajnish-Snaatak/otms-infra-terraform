pipeline {
    agent any

    options {
        timestamps()          
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION  = "us-east-1"
        TF_IN_AUTOMATION    = "true"
        TF_PLUGIN_CACHE_DIR = "/var/lib/jenkins/.terraform.d/plugin-cache"
    }

    stages {

        stage('Checkout Terraform Repo') {
            steps {
                echo "Cloning Salary Terraform Repository"
                git branch: 'main',
                    url: 'https://github.com/Rajnish-Snaatak/otms-infra-terraform.git'
            }
        }

        stage('Terraform Init & Apply') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-dev-creds'
                ]]) {
                    script {
                        def modules = [
                            'security-group',
                            'lt',
                            'asg',
                            'asg-policy',
                            'alb-listener-rule'
                        ]

                        for (module in modules) {
                            stage("Deploy ${module}") {
                                dir("env/dev/salary/${module}") {
                                    sh '''
                                        terraform init -reconfigure
                                        terraform validate
                                        terraform plan
                                        terraform apply -auto-approve
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✔ Terraform Salary Deployment Successful"
        }
        failure {
            echo "❌ Terraform Salary Deployment Failed"
        }
        always {
            cleanWs()
        }
    }
}
